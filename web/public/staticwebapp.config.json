{
  "platform": {
    "apiRuntime": "dotnet-isolated:10.0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{png,jpg,jpeg,ico,svg,webp,mp4,pdf}"]
  },
  "routes": [
    { "route": "/admin*", "allowedRoles": ["admin"] },
    { "route": "/api/manage/*", "allowedRoles": ["admin"] },
    { "route": "/.auth/login/twitter", "statusCode": 404 },
    { "route": "/.auth/login/aad", "statusCode": 404 }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/github?post_login_redirect_uri=.referrer",
      "statusCode": 302
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
